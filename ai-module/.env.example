# ─── Tvarita AI Module — Environment Variables ───────────────────────
#
# Copy this file to .env and fill in the values.
# NEVER commit .env — it contains secrets.

# Backend API base URL (Person A's backend)
BACKEND_API_URL=http://localhost:5000/api

# OpenRouter API key (https://openrouter.ai)
LLM_API_KEY=sk-or-v1-your-openrouter-key-here

# LLM model to use for the chatbot agent.
# Dev/testing (free, rate-limited): google/gemma-4-26b-a4b-it:free
# Demo/production (paid):           google/gemma-4-31b-it
LLM_MODEL=google/gemma-4-26b-a4b-it:free

# Optional timeouts (milliseconds)
BACKEND_TIMEOUT_MS=15000
OPENROUTER_TIMEOUT_MS=60000

# Port for the MCP server (stdio transport is default; this is for future HTTP transport)
MCP_SERVER_PORT=3001
