{
  "name": "tvarita-ai-module",
  "version": "1.0.0",
  "private": true,
  "description": "AI/chatbot layer for Tvarita Arts Platform — MCP server + conversational agent for guest discovery and booking",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
