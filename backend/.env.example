# Server
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:5173

# Database — MongoDB (replica set REQUIRED for Prisma $transaction)
# Local single-node replica set example:
#   mongod --replSet rs0 --port 27017
#   mongosh --eval "rs.initiate({_id:'rs0', members:[{_id:0, host:'127.0.0.1:27017'}]})"
# DATABASE_URL="mongodb://127.0.0.1:27017/tvarita?replicaSet=rs0"
#
# Atlas (replica set built-in):
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/tvarita?retryWrites=true&w=majority"
DATABASE_URL="mongodb://127.0.0.1:27017/tvarita?replicaSet=rs0"

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=change-me-internal-key
ADMIN_BOOTSTRAP_EMAIL=admin@tvarita.org
ADMIN_BOOTSTRAP_PASSWORD=AdminPass123!

# Email (nodemailer SMTP)
# EMAIL_MODE=console  → log to terminal (default for local/dev)
# EMAIL_MODE=smtp     → send via SMTP_HOST (use a Gmail App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Tvarita <no-reply@tvarita.org>"
EMAIL_MODE=console

# Password set token TTL (hours)
PASSWORD_TOKEN_TTL_HOURS=72

# Ask Tvarita RAG / AI Configuration (Never expose keys to frontend)
AI_API_KEY=
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1

