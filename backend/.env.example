# Server
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:5173

# Database (SQLite for local/dev; switch to PostgreSQL in production)
# SQLite:  file:./dev.db
# Postgres: postgresql://USER:PASSWORD@localhost:5432/tvarita
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=change-me-internal-key
ADMIN_BOOTSTRAP_EMAIL=admin@tvarita.org
ADMIN_BOOTSTRAP_PASSWORD=AdminPass123!

# Email (Brevo) — leave unset to log notifications to console in development
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@tvaritacollective.com
BREVO_SENDER_NAME=Tvarita

# Password set token TTL (hours)
PASSWORD_TOKEN_TTL_HOURS=72
