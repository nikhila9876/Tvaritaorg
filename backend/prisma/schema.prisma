// Person B schema — artists, admin, feedback, schools, corporates, timeslots, payouts.
// Bookings/Events are shared: Person A owns writes; Person B reads for admin/artist views.
//
// MongoDB note: Prisma does not enforce referential actions (onDelete/onUpdate).
// Application-level cascades live in src/services/cascadeService.js — Person A must
// use the same pattern for Event/Booking deletes and any atomic slot-lock on
// artist_id + slot_id (requires a replica set for Prisma transactions).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
}

enum FeedbackStatus {
  pending
  approved
  rejected
}

enum PayoutStatus {
  pending
  paid
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Artist {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  email         String     @unique
  passwordHash  String
  name          String
  phone         String?
  artForm       String
  region        String?
  bio           String?
  status        UserStatus @default(active)
  passwordSet   Boolean    @default(false)
  ratingAvg     Float      @default(0)
  ratingCount   Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  passwordTokens PasswordToken[]
  timeslots      TimeSlot[]
  feedback       Feedback[]
  payouts        Payout[]
  bookings       Booking[]
}

model PasswordToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  artistId  String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  artist Artist @relation(fields: [artistId], references: [id])

  @@index([artistId])
}

model School {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  phone     String?
  city      String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Corporate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  name        String
  orgId       String?
  companyName String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TimeSlot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  artistId  String   @db.ObjectId
  date      String
  startTime String
  endTime   String
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([artistId, date, startTime, endTime])
  @@index([artistId, date])
}

model Feedback {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  artistId   String         @db.ObjectId
  eventId    String         @db.ObjectId
  guestEmail String
  guestName  String?
  rating     Int
  comment    String?
  status     FeedbackStatus @default(pending)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  reviewedAt DateTime?

  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([guestEmail, eventId])
  @@index([artistId, status])
  @@index([status, createdAt])
}

/// Shared with Person A (Person A writes; Person B reads).
model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  artForm   String?
  date      String
  startTime String?
  endTime   String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  payouts  Payout[]
}

/// Shared with Person A (Person A writes booking state; Person B may assign artist).
model Booking {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  eventId      String        @db.ObjectId
  artistId     String?       @db.ObjectId
  guestEmail   String?
  guestName    String?
  organization String?
  bookingType  String?
  status       BookingStatus @default(pending)
  grossAmount  Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  event  Event   @relation(fields: [eventId], references: [id])
  artist Artist? @relation(fields: [artistId], references: [id])

  @@index([artistId])
  @@index([eventId])
}

model Payout {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  artistId    String       @db.ObjectId
  eventId     String       @db.ObjectId
  bookingId   String?      @db.ObjectId
  grossAmount Float
  artistShare Float
  status      PayoutStatus @default(pending)
  paidAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  artist Artist @relation(fields: [artistId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])

  @@index([artistId, status])
}

model NotificationLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  channel   String
  to        String
  template  String
  payload   String
  status    String
  error     String?
  createdAt DateTime @default(now())
}

model KnowledgeDocument {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  type      String   // art-form, artist, workshop, experience, tradition, region
  artForm   String?
  region    String?
  content   String
  tags      String[]
  metadata  String?  // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([artForm])
  @@index([region])
}

model CommunityPost {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  authorId     String
  authorName   String
  authorEmail  String?
  authorRole   String      @default("participant") // artist, participant, corporate, admin
  authorAvatar String?
  title        String?
  content      String
  mediaUrls    String[]
  artForm      String?
  category     String      @default("experience") // artwork, experience, workshop, story, tradition
  location     String?
  likeCount    Int         @default(0)
  commentCount Int         @default(0)
  status       String      @default("active") // active, hidden, flagged
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  comments     Comment[]
  likes        PostLike[]
  reports      Report[]

  @@index([status, createdAt])
  @@index([category])
  @@index([artForm])
}

model Comment {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  postId       String        @db.ObjectId
  authorId     String
  authorName   String
  authorEmail  String?
  authorRole   String        @default("participant")
  authorAvatar String?
  content      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  post         CommunityPost @relation(fields: [postId], references: [id])

  @@index([postId, createdAt])
}

model PostLike {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  postId    String        @db.ObjectId
  userId    String
  createdAt DateTime      @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
}

model Report {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  postId        String        @db.ObjectId
  reporterId    String?
  reporterEmail String?
  reason        String
  details       String?
  status        String        @default("pending") // pending, reviewed, dismissed, actioned
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  post          CommunityPost @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([status, createdAt])
}


