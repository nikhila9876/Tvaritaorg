// Shared Prisma schema — Person A writes Event/Booking/Payment/Guest;
// Person B owns Artist/Admin/Feedback/School/Corporate and reads bookings.
//
// MongoDB: no DB-level FK cascades — use cascadeService.js for deletes.
// Replica set required for Prisma $transaction (slot locks, CSV, payments).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
}

enum FeedbackStatus {
  pending
  approved
  rejected
}

enum PayoutStatus {
  pending
  paid
}

enum BookingStatus {
  pending
  hold
  awaiting_payment
  confirmed
  cancelled
  completed
  no_artist_available_pending_admin
}

enum PaymentStatus {
  created
  pending
  succeeded
  failed
}

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Artist {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  email         String     @unique
  passwordHash  String
  name          String
  phone         String?
  artForm       String
  region        String?
  bio           String?
  status        UserStatus @default(active)
  passwordSet   Boolean    @default(false)
  ratingAvg     Float      @default(0)
  ratingCount   Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  passwordTokens PasswordToken[]
  timeslots      TimeSlot[]
  feedback       Feedback[]
  payouts        Payout[]
  bookings       Booking[]
}

model PasswordToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  artistId  String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  artist Artist @relation(fields: [artistId], references: [id])

  @@index([artistId])
}

model School {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  phone     String?
  city      String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Corporate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  name        String
  orgId       String?
  companyName String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TimeSlot {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  artistId          String    @db.ObjectId
  date              String
  startTime         String
  endTime           String
  available         Boolean   @default(true)
  lockedUntil       DateTime?
  lockedByBookingId String?   @db.ObjectId
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([artistId, date, startTime, endTime])
  @@index([artistId, date])
  @@index([lockedUntil])
}

model Feedback {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  artistId   String         @db.ObjectId
  eventId    String         @db.ObjectId
  guestEmail String
  guestName  String?
  rating     Int
  comment    String?
  status     FeedbackStatus @default(pending)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  reviewedAt DateTime?

  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([guestEmail, eventId])
  @@index([artistId, status])
  @@index([status, createdAt])
}

model State {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

/// Shared — Person A owns writes; Person B reads.
model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  artForm   String?
  date      String
  startTime String?
  endTime   String?
  location  String?
  stateId   String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state    State?    @relation(fields: [stateId], references: [id])
  bookings Booking[]
  payouts  Payout[]

  @@index([stateId])
  @@index([date])
}

/// Shared — Person A owns writes; Person B may assign artistId on pending-admin.
model Booking {
  id                     String        @id @default(auto()) @map("_id") @db.ObjectId
  eventId                String?       @db.ObjectId
  artistId               String?       @db.ObjectId
  slotId                 String?       @db.ObjectId
  guestEmail             String?
  guestName              String?
  organization           String?
  bookingType            String?
  status                 BookingStatus @default(pending)
  headcount              Int           @default(1)
  grossAmount            Float         @default(0)
  artForm                String?
  date                   String?
  holdExpiresAt          DateTime?
  paymentWindowExpiresAt DateTime?
  schoolId               String?       @db.ObjectId
  corporateId            String?       @db.ObjectId
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  event    Event?    @relation(fields: [eventId], references: [id])
  artist   Artist?   @relation(fields: [artistId], references: [id])
  payments Payment[]

  @@index([artistId])
  @@index([eventId])
  @@index([status, holdExpiresAt])
  @@index([status, paymentWindowExpiresAt])
  @@index([artistId, date, status])
}

/// Person A — unique claim on artist+date for School/Corporate race protection
model ArtistDateHold {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  artistId  String   @db.ObjectId
  date      String
  bookingId String?  @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([artistId, date])
  @@index([bookingId])
}

model Payout {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  artistId    String       @db.ObjectId
  eventId     String       @db.ObjectId
  bookingId   String?      @db.ObjectId
  grossAmount Float
  artistShare Float
  status      PayoutStatus @default(pending)
  paidAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  artist Artist @relation(fields: [artistId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])

  @@index([artistId, status])
}

model NotificationLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  channel   String
  to        String
  template  String
  payload   String
  status    String
  error     String?
  createdAt DateTime @default(now())
}

/// Person A — guest OTP auth
model Guest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps GuestOtp[]
}

model GuestOtp {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  guestId   String?   @db.ObjectId
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  guest Guest? @relation(fields: [guestId], references: [id])

  @@index([email, createdAt])
}

/// Person A — payments (idempotent webhook via gatewayPaymentId unique)
model Payment {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId         String        @db.ObjectId
  amount            Float
  currency          String        @default("INR")
  headcount         Int
  ratePerHead       Float
  status            PaymentStatus @default(created)
  gatewayPaymentId  String?       @unique
  gatewayOrderId    String?
  idempotencyKey    String?       @unique
  splitRecorded     Boolean       @default(false)
  confirmedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
}
