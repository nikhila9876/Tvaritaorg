# Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Backend API ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api

# ─── Razorpay (PUBLIC key only — NEVER put the secret here) ──────────────────
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# ─── App Info ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=Tvarita Arts Collective

# ─── Variables that MUST stay backend-only (DO NOT add to frontend .env) ──────
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=no-reply@tvaritacollective.com
# BREVO_SENDER_NAME=Tvarita
# JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
# MONGODB_URI=mongodb+srv://...
